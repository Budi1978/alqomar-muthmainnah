/*
  # Cegah clickjacking
  X-Frame-Options: SAMEORIGIN

  # Cegah MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Kontrol referrer
  Referrer-Policy: strict-origin-when-cross-origin

  # Izinkan fitur browser secara minimal
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # Paksa HTTPS (HSTS) — aktifkan setelah SSL terkonfirmasi stabil
  # Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; frame-src https://www.google.com https://www.youtube.com; connect-src 'self'; form-action 'self'; base-uri 'self'; upgrade-insecure-requests;
