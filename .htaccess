# ---------- 0. URL CANONICALIZATION ----------
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------- APEX -> WWW (canonical host) ----------
  RewriteCond %{HTTP_HOST} ^alqomar\.sch\.id [NC]
  RewriteRule ^(.*)$ https://www.alqomar.sch.id/$1 [R=301,L]

  # ---------- SITEMAP BERITA: .xml -> generator .php (JANGAN DIHAPUS) ----------
  # Tanpa rule ini, sitemap-berita.xml 404 dan berita tidak terindeks Google.
  RewriteRule ^sitemap-berita\.xml$ sitemap-berita.php [L]

  RewriteRule ^index\.html$ / [R=301,L]
  # RewriteRule ^berita\.html$ /berita/ [R=301,L]
  # ^ DIHAPUS 14/09/2026: /berita/ jadi folder fisik sungguhan (berkas artikel
  # lama + index.html) hari ini, jadi Apache melayani folder itu duluan lewat
  # DirectoryIndex SEBELUM rule redirect sempat jalan. Kalau ada yang mencoba
  # balik ke berita.html dari dalam folder itu, redirect ini melempar lagi ke
  # /berita/ -> LOOP TAK TERHINGGA (kejadian 14/09/2026, 30rb+ request/detik).
  # /berita.html sekarang dilayani apa adanya (nama .html tetap di address bar,
  # bukan cuma masalah kosmetik SEO minor).
  RewriteRule ^(ppdb|spmb-online|rqaq|guru|kb-tkit|sdit|smpit|tahfidz|event|privacy|syarat|sekolah-islam-jakarta-barat)\.html$ /$1 [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(ppdb|spmb-online|rqaq|guru|kb-tkit|sdit|smpit|tahfidz|event|privacy|syarat|sekolah-islam-jakarta-barat)/?$ $1.html [L]

  # ---------- ARSIP BERITA: /berita/ tanpa slug -> isi berita.html ----------
  # Kalau Apache SEMPAT sampai ke rule ini (belum tentu, folder fisik /berita/
  # kadang dilayani duluan oleh DirectoryIndex) -> tampilkan arsip, bukan
  # index.html folder ini (itu template artikel tunggal).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^berita/?$ berita.html [L]

  # ---------- CLEAN URL BERITA (JANGAN DIHAPUS) ----------
  # /berita/{slug} -> berita-detail.php?slug={slug}
  # Tanpa rule ini SEMUA artikel berita 404.
  # Kejadian: 02/06, 04/06, 18/06, 19/07, 02/09 2026.
  RewriteRule ^berita/([^/]+)/?$ berita-detail.php?slug=$1 [L,QSA]
</IfModule>

# ============================================================
#  Al-Qomar Muthmainnah — Performance .htaccess
#  Caching + Kompresi untuk Hostinger (LiteSpeed/Apache)
#  Dibuat: optimasi PageSpeed Juni 2026
# ============================================================

# ---------- 1. KOMPRESI (Gzip / Brotli) ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml application/x-font-ttf font/woff font/woff2
</IfModule>

# ---------- 2. CACHE LIFETIME (Expires) ----------
<IfModule mod_expires.c>
  ExpiresActive On

  # Gambar — cache 1 tahun (di-hash/diganti nama saat update)
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Font — cache 1 tahun
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType application/x-font-ttf    "access plus 1 year"

  # CSS & JS — cache 1 bulan
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType text/javascript           "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"

  # HTML — cache pendek agar update konten cepat tampil
  ExpiresByType text/html                 "access plus 10 minutes"
</IfModule>

# ---------- 3. CACHE-CONTROL HEADERS ----------
<IfModule mod_headers.c>
  # Aset statis: immutable, cache panjang
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2?|ttf|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML: boleh di-revalidate
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  # Keamanan ringan
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
  # HSTS: paksa HTTPS 1 tahun (subdomain alqomar.sch.id sudah HTTPS semua)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # ---------- CSP AKTIF (diberlakukan 2026-09-07 malam) ----------
  # Sebelumnya header aktif hanya memagari frame-ancestors/base-uri/object-src;
  # seluruh pembatasan script/style/connect menumpuk di header Report-Only —
  # dan Report-Only itu TIDAK punya report-uri/report-to, jadi pelanggarannya
  # hanya muncul di console masing-masing pengunjung dan tak pernah terkumpul.
  # Rencana "pantau beberapa minggu lalu aktifkan" tidak akan pernah punya data.
  #
  # Dasar allowlist di bawah: penelusuran host eksternal pada 14 halaman yang
  # benar-benar tayang (beranda, ppdb, spmb-online, rqaq, guru, kb-tkit, sdit,
  # smpit, tahfidz, event, privacy, syarat, profil, cms-alqomar.html).
  # Yang terpakai hanya: cdn.jsdelivr.net, fonts.googleapis.com,
  # fonts.gstatic.com, *.supabase.co, googletagmanager, i.ytimg.com,
  # [www.google.com](https://www.google.com) (sematan peta). cdn.tailwindcss.com SUDAH TIDAK dipakai
  # halaman mana pun sehingga dikeluarkan dari daftar.
  #
  # PENTING: 26 baris program_pendidikan menyimpan foto_url dengan host APEX
  # (https://alqomar.sch.id/images-optimized-alqomar/...) sedangkan halaman
  # disajikan dari www — bagi CSP itu ASAL LAIN. Tanpa apex di img-src,
  # separuh foto kegiatan & galeri lenyap begitu kebijakan diberlakukan.
  # Klien juga sudah menormalkan apex->www agar tidak membayar redirect 301,
  # tapi entri di sini tetap dipertahankan sebagai jaring pengaman untuk
  # halaman lain yang belum dinormalkan.
  #
  # cms-alqomar.html memuat cropper, quill, xlsx, dan supabase-js SEMUANYA dari
  # cdn.jsdelivr.net — sudah masuk daftar, jadi insiden 17 Agu 2026 (CSP ketat
  # mematikan Cropper/Quill) tidak terulang.
  #
  # 'unsafe-inline' pada script-src SENGAJA dipertahankan: seluruh halaman
  # memakai <script> sebaris dan atribut onclick, sedangkan berkas .html statis
  # di Hostinger tidak bisa menyuntik nonce per permintaan. Menghapusnya butuh
  # pembongkaran seluruh penangan sebaris — dikerjakan terpisah, bukan diam-diam.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://www.alqomar.sch.id https://alqomar.sch.id https://*.supabase.co https://*.ytimg.com https://www.googletagmanager.com https://*.google-analytics.com https://www.google.com https://maps.gstatic.com; connect-src 'self' https://*.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://maps.google.com; upgrade-insecure-requests"

  # ---------- CSP TARGET (laporan saja, tidak memblokir) ----------
  # Versi tanpa 'unsafe-inline' + Trusted Types. Ini SENGAJA melaporkan banyak
  # pelanggaran di console: tiap pelanggaran menunjuk satu skrip sebaris yang
  # harus dipindah ke berkas terpisah sebelum tahap berikutnya bisa diaktifkan.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://www.alqomar.sch.id https://alqomar.sch.id https://*.supabase.co https://*.ytimg.com https://www.googletagmanager.com https://*.google-analytics.com https://www.google.com https://maps.gstatic.com; connect-src 'self' https://*.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://maps.google.com; require-trusted-types-for 'script'; upgrade-insecure-requests"

  # Popup wa.me tetap terbuka; yang diputus hanya rujukan balik window.opener.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# ---------- 4. KEEP-ALIVE ----------
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>

# ---------- 5. ARSIP & SNAPSHOT LAMA ----------
# File snapshot/backup dipindah ke _backup/ (2026-09-02).
# Folder arsip ditutup untuk publik, URL lama diarahkan 301 agar tidak 404.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/_backup(/.*)?$                  /
  RedirectMatch 301 ^/index-live.*\.html$             /
  RedirectMatch 301 ^/index-backup-.*\.html$          /
  RedirectMatch 301 ^/images/index-live\.html$        /
  RedirectMatch 301 ^/berita-detail-backup-.*\.html$  /berita
  RedirectMatch 301 ^/berita-backup-.*\.html$         /berita
  # Backup .php ikut ter-cover, bukan cuma .html
  RedirectMatch 301 ^/.*-backup-[0-9]+.*\.php$        /
</IfModule>

# ---------- 6. PROTEKSI FILE NON-PUBLIK ----------
# Penting bila situs di-deploy lewat Git: isi repositori (termasuk .git)
# ikut masuk ke public_html dan bisa diunduh siapa saja tanpa aturan ini.
<IfModule mod_rewrite.c>
  RewriteRule ^\.git(/|$)                - [F,L]
  RewriteRule ^\.claude(/|$)             - [F,L]
  RewriteRule ^memory(/|$)               - [F,L]
  RewriteRule ^docs(/|$)                 - [F,L]
  RewriteRule ^\.env                     - [F,L]
  RewriteRule ^_(headers|redirects)$     - [F,L]
  RewriteRule ^.+\.md$                   - [F,L]
</IfModule>
